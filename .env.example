# Copy this file to .env for local development with `netlify dev`.
# Never commit the real .env file — it's already in .gitignore.

# TwitterAPIs.com bearer key (https://twitterapis.com dashboard)
TWITTERAPIS_KEY=

# OpenAI-compatible API key used by the AI Assistant / Brand Analysis / Job Hunter features
OPENAI_API_KEY=

# Optional — defaults to gpt-4o-mini if not set
OPENAI_MODEL=gpt-4o-mini
